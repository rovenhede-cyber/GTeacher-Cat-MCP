# 表情库来源（末尾斜杠可省略）
STICKER_REPO_URL=https://raw.githubusercontent.com/rovenhede-cyber/stickersforGPT/main/
# 图片地址前缀，默认与 STICKER_REPO_URL 相同
STICKER_IMAGE_BASE=https://raw.githubusercontent.com/rovenhede-cyber/stickersforGPT/main/

# 关系语境默认值：不传 relationship_context 时使用
# intimate（默认，日常聊天/亲密互动） / friend / formal / unknown
DEFAULT_RELATIONSHIP_CONTEXT=intimate

# 可选：覆盖打分权重（不填则用 sticker_config.py 的默认值）
# W_EMOTION=5
# W_TAG=3
# W_TRIGGER=8
# W_INTENSITY_IN=4
# W_INTENSITY_OUT=-8          # 距区间 2 分的扣分
# W_INTENSITY_OUT_STEP=-2     # 每多 1 分再扣
# W_PRIORITY=0.2              # priority 只作排序权重
# W_EMOTION=5
# MIN_MATCH_SCORE=2
